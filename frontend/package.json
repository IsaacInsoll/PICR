    "vite": "^8",
    "vite-plugin-tsconfig-paths": "^1.4.1",
    "vitest": "4.1.11"
  },
  "proxy": "http://localhost:6900/",
  "overrides": {
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "^4.0.2"
    }
  }
