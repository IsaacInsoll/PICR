{
  "name": "app",
  "version": "1.0.6",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint -- --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "release:version": "node ../node_modules/release-it/bin/release-it.js --config package.json"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@georstat/react-native-image-cache": "^3.1.0",
    "@gorhom/bottom-sheet": "^5",
    "@hookform/resolvers": "^5.9.1",
    "@kolking/react-native-avatar": "^2.1.5",
    "@kolking/react-native-rating": "^1.4.2",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@react-native-menu/menu": "2.0.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@rnrepo/expo-config-plugin": "^0.3.6",
    "@shopify/flash-list": "2.3.2",
    "@urql/exchange-graphcache": "^9.0.1",
    "expo": "^57.0.8",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-media-library": "~57.0.3",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "jotai": "2.20.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "^7.86.0",
    "react-native": "0.87.1",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-file-access": "^4.0.3",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-ios-context-menu": "3.2",
    "react-native-ios-utilities": "5.2",
    "react-native-reanimated": "4.6.0",
    "react-native-reanimated-carousel": "^5.0.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-segmented-control-2": "^2.2.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.12.1",
    "urql": "^5.0.4",
    "zeego": "^3.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.18",
    "eslint": "^10.8.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zeego": {
      "@react-native-menu/menu": "2.0.0",
      "react-native-ios-context-menu": "3.2",
      "react-native-ios-utilities": "5.2"
    }
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "github": false,
    "hooks": {
      "after:git:release": [
        "git push origin master",
        "git push origin app-v${version}"
      ]
    },
    "git": {
      "requireBranch": "master",
      "commitMessage": "🚀📱 App release ${version}",
      "tagName": "app-v${version}",
      "commit": true,
      "tag": true,
      "push": false
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
