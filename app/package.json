{
  "name": "app",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check:polyfills": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/check-polyfills.mjs",
    "check:shared-dependencies": "node ./scripts/check-shared-dependencies.mjs",
    "lint": "expo lint -- --max-warnings=0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:maestro": "node ./scripts/run-maestro.mjs .maestro",
    "test:maestro:smoke": "node ./scripts/run-maestro.mjs .maestro/photographer-smoke.yaml",
    "typecheck": "tsc --noEmit",
    "release:version": "node ../node_modules/release-it/bin/release-it.js --config package.json"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@formatjs/intl-getcanonicallocales": "^3.2.11",
    "@formatjs/intl-locale": "^5.3.10",
    "@formatjs/intl-pluralrules": "^6.3.13",
    "@formatjs/intl-relativetimeformat": "^12.3.13",
    "@georstat/react-native-image-cache": "^3.1.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^5.0.1",
    "@kolking/react-native-avatar": "^2.1.5",
    "@kolking/react-native-rating": "^1.4.2",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@react-native-menu/menu": "2.0.0",
    "@shopify/flash-list": "2.0.2",
    "@urql/exchange-graphcache": "^9.0.1",
    "@urql/exchange-retry": "^2.0.0",
    "expo": "~57.0.19",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "format-duration": "^3.0.2",
    "graphql": "^16.14.2",
    "jotai": "2.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.56.4",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-file-access": "^3.1.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-ios-context-menu": "3.2",
    "react-native-ios-utilities": "5.2",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-carousel": "^4.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-segmented-control-2": "^2.1.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "readable-fractions": "^0.1.1",
    "urql": "^5.0.3",
    "wonka": "^6.3.6",
    "zeego": "^3.0.6",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.12.0",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.5.3",
    "test-renderer": "^1.2.0",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "zeego": {
      "@react-native-menu/menu": "2.0.0",
      "react-native-ios-context-menu": "3.2",
      "react-native-ios-utilities": "5.2"
    }
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "github": false,
    "hooks": {
      "after:git:release": [
        "git push origin master",
        "git push origin app-v${version}"
      ]
    },
    "git": {
      "requireBranch": "master",
      "commitMessage": "🚀📱 App release ${version}",
      "tagName": "app-v${version}",
      "commit": true,
      "tag": true,
      "push": false
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
