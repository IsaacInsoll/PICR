# =============================================================================
# PICR Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment.
# Lines starting with # are comments. Uncomment and modify as needed.
#
# For Docker deployments, these are set via docker-compose.yml environment.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED VARIABLES
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# For Docker: postgres://user:pass@db/picr (use service name, not localhost)
# For local dev: postgres://user:pass@localhost:54321/picr
DATABASE_URL=postgres://user:pass@localhost:54321/picr

# Base URL of the server (MUST end with /)
# Used for generating social sharing links (OpenGraph), email notifications, etc.
# For local dev: http://localhost:6900/
# For production: https://photos.yourdomain.com/
BASE_URL=http://localhost:6900/

# Optional override paths for ffmpeg/ffprobe binaries.
# Leave unset to use `ffmpeg` and `ffprobe` from PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Optional override paths for RAW/PSD/PSB/HEIC thumbnail helpers.
# Leave unset to use `exiftool` and `magick` from PATH. These are optional:
# if unavailable, RAW/PSD/PSB/HEIC files remain downloadable generic files.
# EXIFTOOL_PATH=/usr/bin/exiftool
# MAGICK_PATH=/usr/bin/magick

# Hardware video acceleration (VAAPI, Intel/AMD, amd64 image only).
# Detected automatically when you pass a GPU into the container
# (devices: [/dev/dri:/dev/dri]); shown on Server Info and used by the admin
# benchmark. NOTE: thumbnail generation stays on the CPU (it benchmarked faster
# there) — VAAPI is groundwork for future transcoding, so today these mainly
# affect the benchmark. You normally don't need to set either.
# Set VIDEO_ACCELERATION=off to disable VAAPI entirely.
# Set VIDEO_ACCELERATION_DEVICE only when you have multiple GPUs.
# VIDEO_ACCELERATION=auto
# VIDEO_ACCELERATION_DEVICE=/dev/dri/renderD128

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------

# Server port (default: 6900)
# The port the Express server listens on inside the container/process
# PORT=6900

# Node environment (default: production)
# Options: development, test, production
# - development: Enables debug features, auto-migration
# - test: Used by test suite
# - production: Optimized for deployment
NODE_ENV=development

# -----------------------------------------------------------------------------
# FILE WATCHING
# -----------------------------------------------------------------------------

# File watcher mode (default: native)
# Options:
# - native: OS file watching
# - polling: chokidar polling, useful for Docker/NAS/network drives
# - off: no watcher; use boot, "Scan Now", and optional ON_VIEW_SCAN scans
FILE_WATCHER=polling
#
# Legacy alias still supported in 1.x:
# USE_POLLING=true

# Polling interval in seconds (default: 20)
# Used only when FILE_WATCHER=polling.
# Higher values reduce NAS/CPU activity but increase detection latency.
POLLING_SECONDS=20
#
# Legacy alias still supported in 1.x:
# POLLING_INTERVAL=200 # old 100ms units; this becomes POLLING_SECONDS=20

# Demand-driven scan when a folder is viewed (default: off)
# Options:
# - off: disabled
# - direct: scan only the viewed folder
# - direct_and_new: scan viewed folder and newly-discovered direct subfolders
# - one_level: scan viewed folder and all direct subfolders
# Root/Home always scans direct-only to avoid walking the whole library.
ON_VIEW_SCAN=off

# Scheduled whole-library reconcile backstop (default: 0/off)
# Runs inside PICR every N hours. Useful with FILE_WATCHER=off to catch changes
# nobody viewed yet. New-file thumbnails are pre-warmed only for small batches.
SCHEDULED_SCAN_HOURS=0

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# Initial admin account (only used on first boot, when no users exist yet)
# ADMIN_PASSWORD sets the password for the auto-created admin account
# (minimum 8 characters). If it is NOT set, a strong random password is generated
# and printed to the logs once on first boot — read it with `docker logs picr`.
# ADMIN_USERNAME is optional and defaults to "admin".
# These have no effect once users exist; change passwords via the app afterwards.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-to-something-strong

# JWT token secret (optional, auto-generated if not set)
# If provided, must be at least 64 characters
# The server will auto-generate and store this in the database on first boot
# Only set this if you need to use a specific secret (e.g., for testing)
# TOKEN_SECRET=your-very-long-secret-key-at-least-64-characters-for-security

# Login rate limiting (defaults shown)
# Helps reduce brute-force login attempts on the auth mutation.
# LOGIN_RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=30
# LOGIN_RATE_LIMIT_USER_IP_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_BLOCK_MINUTES=15
# LOGIN_RATE_LIMIT_MAX_BLOCK_MINUTES=60

# -----------------------------------------------------------------------------
# DEBUGGING & LOGGING
# -----------------------------------------------------------------------------

# Enable SQL query logging (default: false)
# Logs all Drizzle ORM queries - useful for debugging, very verbose
# DEBUG_SQL=true

# Enable console logging (default: false)
# By default, logs go to cache/error.log and cache/info.log
# Enable this to also output to console (useful for Docker logs)
CONSOLE_LOGGING=true

# -----------------------------------------------------------------------------
# ADVANCED / RARELY NEEDED
# -----------------------------------------------------------------------------

# Enable file write operations (default: auto-detected)
# This allows you to move/rename/copy files and folders.
# The server tests write access to the media folder on startup so you need both (a) CAN_WRITE=true and (b) actual write access to '/media` path for this to be useful
# CAN_WRITE=true

# Disable AccessLog recording (default: false)
# When true, no AccessLog rows are written for folder views or downloads,
# and no folder-view notifications are sent. Existing logs are not deleted.
# Useful for deployments where audit logging isn't wanted (e.g. privacy concerns)
# or to reduce database growth. Requires a server restart to change.
# DISABLE_ACCESS_LOGS=true
