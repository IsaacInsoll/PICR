{
  "name": "picr",
  "description": "",
  "exports": "./app.ts",
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .ts --max-warnings=0",
    "build": "rm -rf ../dist/server && tsc && tsc-alias && cd .. && sh ./copy-backend-files.sh",
    "start": " node ../dist/server/backend/app.js",
    "gql:schema": "TSX_TSCONFIG_PATH=tsconfig.json node --import tsx scripts/exportGraphqlSchema.ts ../.scratch/codegen-schema.json",
    "gql:generate": "npm run gql:schema && graphql-codegen --config codegen.ts",
    "dk": "DOTENV_CONFIG_PATH=../.env NODE_OPTIONS='--import tsx' drizzle-kit",
    "dk:generate": "sh -c 'if [ -z \"$MIGRATION_NAME\" ]; then echo \"MIGRATION_NAME is required. Example: MIGRATION_NAME=branding-upgrades npm run dk:generate\"; exit 1; fi; npm run dk -- generate --name=\"$MIGRATION_NAME\"'"
  },
  "author": "Isaac Insoll",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "blurhash": "^2.0.5",
    "chokidar": "^5",
    "compression": "^1.8.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "exif-reader": "^2.0.3",
    "expo-server-sdk": "^4.0.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.5.9",
    "graphql": "^16.8.1",
    "graphql-http": "^1.22.0",
    "graphql-scalars": "^1.23.0",
    "join-images": "^1.1.5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18",
    "semver": "^7.7.1",
    "sharp": "^0.35.3",
    "winston": "^3.19",
    "yauzl": "^3.4.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-codegen/introspection": "^6.1.0",
    "@types/archiver": "^6.0.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^25.1",
    "@types/pg": "^8.16",
    "@types/semver": "^7.7.1",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "overrides": {
    "join-images": {
      "sharp": "^0.35"
    }
  }
}
